[Unit]
Description=KOI-net Obsidian manager node
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/telescope-koi-network
ExecStart=%h/telescope-koi-network/.venv/bin/python -m koi_net_obsidian_manager_node obsidian_manager
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target